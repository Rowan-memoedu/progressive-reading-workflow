{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progressive-reading.split-manifest/v2",
  "title": "Progressive reading hierarchical semantic split manifest v2",
  "type": "object",
  "required": ["manifest_version", "split_policy_version", "source_sha256", "source_type", "source_block_count", "reference_labels", "hierarchy", "source_unit_count", "leaf_split_count", "split_count", "line_basis", "policy", "units", "splits"],
  "properties": {
    "manifest_version": { "const": "progressive-reading.split-manifest/v2" },
    "split_policy_version": { "const": "heading-semantic-hierarchy-v2" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "source_type": { "type": "string", "minLength": 1 },
    "source_url": { "type": ["string", "null"] },
    "source_block_count": { "type": "integer", "minimum": 1 },
    "reference_labels": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "hierarchy": { "const": "source_units_with_semantic_leaves" },
    "source_unit_count": { "type": "integer", "minimum": 1 },
    "leaf_split_count": { "type": "integer", "minimum": 1 },
    "split_count": { "type": "integer", "minimum": 1 },
    "line_basis": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "required": ["heading_level", "max_chars", "max_lines", "semantic_long_section_splitting"],
      "properties": {
        "heading_level": { "const": 2 },
        "max_chars": { "type": "integer", "minimum": 1 },
        "max_lines": { "type": "integer", "minimum": 1 },
        "semantic_long_section_splitting": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unit" }
    },
    "splits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/split" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "boundary": {
      "type": "object",
      "required": ["source_block_key", "source_index", "line"],
      "properties": {
        "source_block_key": { "type": "string", "pattern": "^src-[0-9]{4}-[a-f0-9]{8}$" },
        "source_index": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["algorithm", "exercise", "proof", "remark", "objectives", "true_code_fence", "display_math", "image", "citation", "url", "visible_pandoc_attribute"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "unit": {
      "type": "object",
      "required": ["unit_id", "source_title", "source_heading", "source_heading_level", "source_boundary", "source_block_count", "leaf_count", "leaf_split_ids", "split_reason"],
      "properties": {
        "unit_id": { "type": "string", "pattern": "^unit-[0-9]{2}-[a-f0-9]{8}$" },
        "source_title": { "type": "string", "minLength": 1 },
        "source_heading": { "type": "string", "minLength": 1 },
        "source_heading_level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "source_boundary": {
          "type": "object",
          "required": ["start", "end"],
          "properties": { "start": { "$ref": "#/$defs/boundary" }, "end": { "$ref": "#/$defs/boundary" } },
          "additionalProperties": false
        },
        "source_block_count": { "type": "integer", "minimum": 1 },
        "leaf_count": { "type": "integer", "minimum": 1 },
        "leaf_split_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^split-[0-9]{2}-[a-f0-9]{8}$" } },
        "split_reason": { "enum": ["source_heading_boundary", "long_source_unit_semantic_split"] }
      },
      "additionalProperties": false
    },
    "split": {
      "type": "object",
      "required": ["split_id", "parent_unit_id", "title", "source_title", "source_heading", "source_heading_level", "semantic_role", "split_reason", "leaf_index", "leaf_count", "source_boundary", "estimated_non_whitespace_chars", "estimated_lines", "source_block_count", "special_structures", "suggested_filename", "source_sha256"],
      "properties": {
        "split_id": { "type": "string", "pattern": "^split-[0-9]{2}-[a-f0-9]{8}$" },
        "parent_unit_id": { "type": "string", "pattern": "^unit-[0-9]{2}-[a-f0-9]{8}$" },
        "title": { "type": "string", "minLength": 1 },
        "source_title": { "type": "string", "minLength": 1 },
        "source_heading": { "type": "string", "minLength": 1 },
        "source_heading_level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "semantic_role": { "enum": ["section", "principles", "algorithm_correctness", "efficiency_progress", "topic_extension"] },
        "split_reason": { "enum": ["source_heading_boundary", "long_source_unit_semantic_split"] },
        "leaf_index": { "type": "integer", "minimum": 1 },
        "leaf_count": { "type": "integer", "minimum": 1 },
        "source_boundary": {
          "type": "object",
          "required": ["start", "end"],
          "properties": { "start": { "$ref": "#/$defs/boundary" }, "end": { "$ref": "#/$defs/boundary" } },
          "additionalProperties": false
        },
        "estimated_non_whitespace_chars": { "type": "integer", "minimum": 1 },
        "estimated_lines": { "type": "integer", "minimum": 1 },
        "source_block_count": { "type": "integer", "minimum": 1 },
        "special_structures": { "$ref": "#/$defs/counts" },
        "suggested_filename": { "type": "string", "pattern": "\\.md$" },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
