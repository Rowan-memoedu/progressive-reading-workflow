{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progressive-reading.preprocess.request/v1",
  "title": "Progressive reading preprocessing request v1",
  "type": "object",
  "required": ["schema_version", "contract_version", "source_type", "source_metadata", "user_instruction"],
  "properties": {
    "schema_version": { "const": "progressive-reading.preprocess.request/v1" },
    "contract_version": { "const": "1.0.0" },
    "material_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "source_type": { "type": "string", "minLength": 1 },
    "source_metadata": {
      "type": "object",
      "properties": {
        "source_url": { "type": ["string", "null"] },
        "canonical_url": { "type": ["string", "null"] },
        "original_url": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "published_at": { "type": ["string", "null"] },
        "input_form": { "enum": ["spoken_transcript", "written"] },
        "content_profile": { "enum": ["natural_language", "math_lecture", "literature"] },
        "language": { "type": "string", "minLength": 2, "maxLength": 32 },
        "source_is_original": { "type": "boolean" },
        "translation": {
          "type": "object",
          "properties": {
            "is_translation": { "type": "boolean" },
            "is_bilingual": { "type": "boolean" },
            "original_url": { "type": ["string", "null"] },
            "original_language": { "type": "string" },
            "translation_language": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "user_instruction": { "type": "string" },
    "processing_options": {
      "type": "object",
      "$comment": "Runtime MUST enforce insight_soft_min <= insight_soft_max <= insight_safety_cap when the related fields are present; portable JSON Schema cannot compare sibling numeric values.",
      "properties": {
        "workflow_mode": { "enum": ["standard", "single_stage"] },
        "include_reading_guide": { "type": "boolean" },
        "spoken_to_written": { "type": "boolean" },
        "structure_body": { "type": "boolean" },
        "translate": { "type": "boolean" },
        "input_form": { "enum": ["auto", "spoken_transcript", "written"] },
        "content_profile": { "enum": ["auto", "natural_language", "math_lecture", "literature"] },
        "source_language": { "type": "string", "minLength": 2, "maxLength": 32 },
        "original_placement": { "const": "after_translation" },
        "cleaning_mode": { "enum": ["semantic_only", "source_voice_structuring", "lossless_spoken_to_written", "source_translation"] },
        "translation_target_language": { "type": "string", "minLength": 2, "maxLength": 32 },
        "translation_mode": { "enum": ["terminology", "plain"] },
        "preserve_source_voice": { "type": "boolean" },
        "forbid_visible_timestamps": { "type": "boolean" },
        "require_content_headings": { "type": "boolean" },
        "attribute_unverified_claims": { "type": "boolean" },
        "normalize_semantic_containers": { "type": "boolean" },
        "insight_soft_min": { "type": "integer", "minimum": 0, "maximum": 24 },
        "insight_soft_max": { "type": "integer", "minimum": 1, "maximum": 24 },
        "insight_safety_cap": { "type": "integer", "minimum": 1, "maximum": 24 }
      },
      "additionalProperties": false
    },
    "material": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["markdown"],
          "properties": {
            "markdown": { "type": "string", "minLength": 1 },
            "original_markdown": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "input": { "type": "string", "minLength": 1 }
  },
  "anyOf": [
    { "required": ["material"] },
    { "required": ["input"] }
  ],
  "additionalProperties": false
}
