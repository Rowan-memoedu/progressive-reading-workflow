{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progressive-reading.rich-text-package/v1",
  "title": "Progressive Reading Rich Text Extraction Package",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "status",
    "source",
    "extractor",
    "markdown_path",
    "quality_path",
    "extraction_result_path",
    "assets",
    "downstream",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "progressive-reading.rich-text-package/v1" },
    "created_at": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "partial", "ocr_required", "failed"] },
    "source": {
      "type": "object",
      "required": ["format", "file_name", "mime_type", "sha256", "bytes", "copy_path"],
      "properties": {
        "format": { "enum": ["pdf", "epub", "docx", "txt"] },
        "file_name": { "type": "string", "minLength": 1 },
        "mime_type": { "enum": ["application/pdf", "application/epub+zip", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "text/plain"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "copy_path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "extractor": {
      "type": "object",
      "required": ["name", "format_extractor"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "format_extractor": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "markdown_path": { "type": ["string", "null"] },
    "quality_path": { "const": "quality.json" },
    "extraction_result_path": { "const": "extraction-result.json" },
    "assets": { "type": "array", "items": { "type": "object" } },
    "downstream": {
      "type": "object",
      "required": ["request_path", "eligible", "reason"],
      "properties": {
        "request_path": { "type": ["string", "null"] },
        "eligible": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
