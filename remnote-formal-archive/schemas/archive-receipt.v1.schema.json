{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progressive-reading.remnote-archive-receipt/v1",
  "title": "Progressive Reading formal archive receipt",
  "type": "object",
  "required": ["schema", "engineVersion", "status", "packageId", "packageRevision", "payloadHash", "packageFile"],
  "properties": {
    "schema": { "const": "progressive-reading.remnote-archive-receipt/v1" },
    "engineVersion": { "type": "string" },
    "status": { "enum": ["archived", "partial_failure"] },
    "packageId": { "type": "string", "minLength": 1 },
    "packageRevision": { "type": "integer", "minimum": 1 },
    "payloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "packageFile": { "type": "string", "minLength": 1 },
    "target": { "type": "object" },
    "readback": { "type": "object" },
    "localFinalization": { "type": "object" },
    "completedAt": { "type": "string", "format": "date-time" },
    "failedAt": { "type": "string", "format": "date-time" },
    "error": { "type": "object" }
  },
  "additionalProperties": true
}
