{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progressive-reading.local-ir-export-package/v1",
  "title": "Progressive Reading Local IR export package",
  "type": "object",
  "required": ["schema", "packageId", "packageRevision", "status", "title", "sourcePath", "localArchive", "annotations", "cards", "clozeCards", "articleMusings"],
  "properties": {
    "schema": { "const": "progressive-reading.local-ir-export-package/v1" },
    "packageId": { "type": "string", "minLength": 1 },
    "packageRevision": { "type": "integer", "minimum": 1 },
    "status": { "const": "export_package_ready" },
    "title": { "type": "string", "minLength": 1 },
    "sourcePath": { "type": "string", "minLength": 1 },
    "localArchive": {
      "type": "object",
      "required": ["state", "sourcePath", "archivedSourcePath"],
      "properties": {
        "state": { "const": "export_package_ready" },
        "sourcePath": { "type": "string", "minLength": 1 },
        "archivedSourcePath": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "annotations": { "type": "array", "items": { "$ref": "#/$defs/identifiedItem" } },
    "cards": { "type": "array", "items": { "$ref": "#/$defs/identifiedItem" } },
    "clozeCards": { "type": "array", "items": { "$ref": "#/$defs/identifiedItem" } },
    "articleMusings": { "type": "array" }
  },
  "$defs": {
    "identifiedItem": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    }
  },
  "additionalProperties": true
}
