    "rss:sync": "node scripts/rss-workflow.mjs sync",
    "rss:resolve": "node scripts/rss-workflow.mjs resolve",
    "rss:promote": "node scripts/rss-workflow.mjs promote",
    "rss:health": "node scripts/rss-workflow.mjs health",
    "rss:sources": "node scripts/rss-workflow.mjs sources",
    "rss:add-source": "node scripts/rss-workflow.mjs add-source",
    "rss:schedule": "node scripts/rss-workflow.mjs schedule",
    "rss:services:up": "node scripts/rss-workflow.mjs services-up",
    "rss:services:down": "node scripts/rss-workflow.mjs services-down",
    "rss:services:ps": "node scripts/rss-workflow.mjs services-ps"
